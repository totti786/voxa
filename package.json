{
  "name": "voxa-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["web", "server"],
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "build:server": "npm run build --prefix server",
    "build:web": "npm run build --prefix web",
    "build": "npm run build:server && npm run build:web",
    "test:server": "npm run test --prefix server",
    "test:web": "npm run test --prefix web",
    "test": "npm run test:server && npm run test:web",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w web && npm run typecheck -w server"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "prettier": "^3.2.0"
  }
}
